/* List Widgets */
QListWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.9),
        stop:1 rgba(248, 250, 252, 0.8));
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 10px;
    color: #374151;
    padding: 4px;
}

QListWidget::item {
    background: transparent;
    padding: 6px;
    border-radius: 6px;
    margin: 2px;
}

QListWidget::item:selected {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(59, 130, 246, 0.15),
        stop:1 rgba(99, 102, 241, 0.1));
    border: 1px solid rgba(59, 130, 246, 0.3);
}

QListWidget::item:hover {
    background: rgba(0, 0, 0, 0.04);
}

/* Tree Widgets */
QTreeWidget {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.9),
        stop:1 rgba(248, 250, 252, 0.8));
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 10px;
    color: #374151;
    padding: 4px;
    alternate-background-color: rgba(0, 0, 0, 0.02);
}

QTreeWidget::item {
    padding: 4px;
    border-radius: 4px;
}

QTreeWidget::item:selected {
    background: rgba(59, 130, 246, 0.15);
    border: 1px solid rgba(59, 130, 246, 0.3);
}

QTreeWidget::item:hover {
    background: rgba(0, 0, 0, 0.04);
}

/* Tab Widgets */
QTabWidget::pane {
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 10px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.8),
        stop:1 rgba(248, 250, 252, 0.7));
}

QTabBar::tab {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.7),
        stop:1 rgba(241, 245, 249, 0.6));
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-bottom: none;
    padding: 8px 16px;
    margin: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    color: #6b7280;
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(59, 130, 246, 0.1),
        stop:1 rgba(99, 102, 241, 0.05));
    border: 1px solid rgba(59, 130, 246, 0.3);
    border-bottom: none;
    color: #374151;
}

QTabBar::tab:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.8),
        stop:1 rgba(241, 245, 249, 0.7));
}

/* Scroll Bars */
QScrollBar:vertical {
    background: rgba(0, 0, 0, 0.05);
    width: 12px;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 0, 0, 0.15),
        stop:1 rgba(0, 0, 0, 0.1));
    border-radius: 6px;
    min-height: 20px;
    margin: 2px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 0, 0, 0.2),
        stop:1 rgba(0, 0, 0, 0.15));
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    subcontrol-position: none;
}

QScrollBar:horizontal {
    background: rgba(0, 0, 0, 0.05);
    height: 12px;
    border-radius: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(0, 0, 0, 0.15),
        stop:1 rgba(0, 0, 0, 0.1));
    border-radius: 6px;
    min-width: 20px;
    margin: 2px;
}

QScrollBar::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(0, 0, 0, 0.2),
        stop:1 rgba(0, 0, 0, 0.15));
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    subcontrol-position: none;
}

/* Group Boxes */
QGroupBox {
    /*background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.6),
        stop:1 rgba(248, 250, 252, 0.5));*/
    /*background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #fff8ed99,
        stop:1 #fffcf680;*/
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 252, 246, 0.95),
        stop:0.5 rgba(255, 248, 237, 0.9),
        stop:1 rgba(255, 252, 246, 0.95));
    /*background: #fff8ed;*/
    /*background: transparent;*/
    border: 1.5px solid rgba(0, 0, 0, 0.08);
    border-radius: 65px;
    font-weight: bold;
    /*padding-top: 15px;
    margin-top: 10px;*/
    color: #374151;
}

/*QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 8px 0 8px;
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(59, 130, 246, 0.1),
        stop:1 rgba(99, 102, 241, 0.08));
    border-radius: 6px;
    color: #374151;
}*/

/* Check Boxes */
QCheckBox {
    color: #374151;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 4px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.9),
        stop:1 rgba(248, 250, 252, 0.8));
}

QCheckBox::indicator:hover {
    border: 1px solid rgba(59, 130, 246, 0.3);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.95),
        stop:1 rgba(248, 250, 252, 0.85));
}

QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(59, 130, 246, 0.9),
        stop:1 rgba(37, 99, 235, 0.95));
    border: 1px solid rgba(59, 130, 246, 0.6);
}

/* Radio Buttons */
QRadioButton {
    color: #374151;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border-radius: 9px;
    border: 1px solid rgba(0, 0, 0, 0.2);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.9),
        stop:1 rgba(248, 250, 252, 0.8));
}

QRadioButton::indicator:hover {
    border: 1px solid rgba(59, 130, 246, 0.3);
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.95),
        stop:1 rgba(248, 250, 252, 0.85));
}

QRadioButton::indicator:checked {
    background: qradialGradient(cx:0.5, cy:0.5, radius:0.8,
        stop:0 rgba(59, 130, 246, 0.9),
        stop:0.5 rgba(37, 99, 235, 0.8),
        stop:1 rgba(29, 78, 216, 0.7));
    border: 1px solid rgba(59, 130, 246, 0.6);
}

/* Sliders */
QSlider::groove:horizontal {
    height: 6px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(0, 0, 0, 0.08),
        stop:1 rgba(255, 255, 255, 0.3));
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: qradialGradient(cx:0.5, cy:0.5, radius:1,
        stop:0 rgba(255, 255, 255, 0.95),
        stop:0.8 rgba(241, 245, 249, 0.9),
        stop:1 rgba(226, 232, 240, 0.85));
    border: 1px solid rgba(0, 0, 0, 0.15);
    width: 18px;
    margin: -6px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: qradialGradient(cx:0.5, cy:0.5, radius:1,
        stop:0 rgba(59, 130, 246, 0.9),
        stop:0.8 rgba(37, 99, 235, 0.8),
        stop:1 rgba(29, 78, 216, 0.7));
    border: 1px solid rgba(59, 130, 246, 0.5);
}

/* Progress Bars */
QProgressBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(0, 0, 0, 0.08),
        stop:1 rgba(255, 255, 255, 0.3));
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 10px;
    text-align: center;
    color: #374151;
    font-weight: bold;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(34, 197, 94, 0.9),
        stop:0.5 rgba(22, 163, 74, 0.95),
        stop:1 rgba(21, 128, 61, 0.9));
    border-radius: 8px;
    margin: 2px;
}

/* Menu Bars */
QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.8),
        stop:1 rgba(248, 250, 252, 0.7));
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    color: #374151;
}

QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background: rgba(0, 0, 0, 0.06);
}

QMenu {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.95),
        stop:1 rgba(248, 250, 252, 0.9));
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    color: #374151;
    padding: 4px;
}

QMenu::item {
    background: transparent;
    padding: 6px 20px;
    border-radius: 4px;
}

QMenu::item:selected {
    background: rgba(59, 130, 246, 0.1);
}

/* Tool Buttons */
QToolButton {
    /*background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.8),
        stop:1 rgba(255, 255, 255, 0.6));
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    padding: 6px;
    color: #374151;*/
    margin: 0.5px;
    padding: 0px;
    border: none;
}

QToolButton:hover {
    /*background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.9),
        stop:1 rgba(255, 255, 255, 0.7));
    border: 1px solid rgba(59, 130, 246, 0.15);*/
    margin: 0px;
    padding: 0px;
    border: none;
}

QToolButton:pressed {
    /*background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(59, 130, 246, 0.15),
        stop:1 rgba(59, 130, 246, 0.08));*/
    margin: 1px;
    padding: 0px;
    border: none;
}

QToolButton:disabled {
    background: transparent;
    border: transparent;
    color: transparent;
}

/* Status Bar */
QStatusBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(248, 250, 252, 0.8),
        stop:1 rgba(255, 255, 255, 0.6));
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    color: #6b7280;
}

/* Spin Boxes */
QSpinBox, QDoubleSpinBox {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(255, 255, 255, 0.9),
        stop:1 rgba(248, 250, 252, 0.8));
    border: 1px solid rgba(0, 0, 0, 0.1);
    border-radius: 8px;
    padding: 4px 8px;
    color: #374151;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid rgba(59, 130, 246, 0.4);
}

QSpinBox::up-button, QDoubleSpinBox::up-button {
    background: rgba(0, 0, 0, 0.05);
    border: none;
    border-radius: 4px;
    width: 16px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover {
    background: rgba(59, 130, 246, 0.1);
}

QSpinBox::down-button, QDoubleSpinBox::down-button {
    background: rgba(0, 0, 0, 0.05);
    border: none;
    border-radius: 4px;
    width: 16px;
}

QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background: rgba(59, 130, 246, 0.1);
}